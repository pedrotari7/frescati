# Emulator-only values for the secrets the functions declare.
#
# Committed on purpose, like `.env` beside it, and for the mirror-image reason:
# that file exists because a deploy fails without it, this one exists because a
# local run is noisy with it missing. The functions emulator resolves every
# `defineSecret` when it starts a runtime worker, and with no override here it
# goes to Secret Manager for the real value. On a machine that has run
# `firebase login` that is a wasted round trip per worker; in CI, where there is
# no credential and no reason for one, every worker instead logs "Unable to
# access secret environment variables" and each seeded trigger prints it again.
# Nothing breaks either way — the value is never used — which is what makes it
# worth silencing rather than fixing at the callsite: a red-looking line in a
# green run is a line somebody has to re-read every time.
#
# The value is a placeholder and has to stay one. `sendEmail` returns as soon as
# it sees `FUNCTIONS_EMULATOR` — the emulator logs what it would have sent
# rather than sending it — so it is read on no local path, and a real key here
# would be a real key sitting in a tracked file for nothing. The real one lives
# in Secret Manager and is bound into the functions at deploy time.
#
# Only the emulator reads this. `firebase deploy` never looks at it, and
# `firebase.json` keeps it out of the uploaded source.

RESEND_API_KEY=emulator-placeholder
