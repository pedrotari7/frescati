{
	// `pnpm seed` runs through `ts-node --transpile-only`, which is what makes it
	// quick enough to sit in front of every `dev:seeded` and every e2e run, and
	// transpiling means nothing typechecks it there. The build above cannot
	// stand in: it excludes `scripts/` on purpose, because none of it is deployed
	// with the functions.
	//
	// So the check moves here, to a config that compiles nothing and is run once
	// in CI rather than on every seed. It covers every script, not just the
	// seeder: the backfills and the one-off repairs still run through a checking
	// ts-node, but they are the scripts nobody runs until the day they matter.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": ["scripts/**/*.ts", "src/**/*.ts", "../shared/**/*.ts"],
	"exclude": ["node_modules", "lib", "../shared/**/*.test.ts"]
}
