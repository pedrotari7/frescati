{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"license": "ISC",
	"main": "lib/backend/src/index.js",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"lint": "eslint . --ext .ts",
		"build": "tsc",
		"typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
		"watch": "tsc --watch --preserveWatchOutput",
		"serve": "pnpm build && firebase emulators:start --only functions,firestore",
		"logs": "firebase functions:log",
		"seed": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/seed.ts",
		"set-admin": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/setAdmin.ts",
		"deploy-cors": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/deployCors.ts",
		"backfill-kickoff-millis": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/backfillKickoffMillis.ts",
		"backfill-motm-voters": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/backfillMotmVoters.ts",
		"backfill-ledger-teams": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/backfillLedgerTeams.ts",
		"backfill-ledger-seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/backfillLedgerSeed.ts",
		"backfill-debtors": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/backfillDebtors.ts",
		"strip-user-emails": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/stripUserEmails.ts",
		"forget-player": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/forgetPlayer.ts",
		"recount-games": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/recountGames.ts",
		"rate-replay-report": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/rateReplayReport.ts",
		"replay-ratings": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/replayRatings.ts",
		"whoami": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/whoami.ts",
		"prune-orphans": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/pruneOrphans.ts"
	},
	"dependencies": {
		"@firebase/app": "0.14.12",
		"@sentry/node": "10.70.0",
		"firebase-admin": "13.10.0",
		"firebase-functions": "7.2.5"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@typescript-eslint/eslint-plugin": "8.60.0",
		"@typescript-eslint/parser": "8.60.0",
		"eslint": "8.57.1",
		"ts-node": "10.9.2",
		"typescript": "5.9.3"
	}
}
