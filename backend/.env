# Deploy-time configuration for the Cloud Functions.
#
# Committed on purpose, and the one `.env` in the repo that is — these are
# `defineString` parameters, not secrets, and `firebase deploy` reads them from
# here. Left out of this file entirely, a non-interactive deploy (which is what
# CI runs) fails outright rather than falling back to a default. Anything that
# must stay private goes in Secret Manager instead:
#
#   firebase functions:secrets:set RESEND_API_KEY
#
# ── Email fallback ───────────────────────────────────────────────────────────
# Both blank means no email is ever sent, which is the safe default: a push that
# reaches nobody just reaches nobody, exactly as before this existed.

# Sender, on a domain verified with Resend.
#   EMAIL_FROM=Frescati <notifications@your-domain.com>
EMAIL_FROM=Frescati <notifications@frescati.xyz>

# The app's public origin, no trailing slash. Push payloads carry relative
# links because a service worker resolves them against its own scope; a mail
# client has no such origin, so the email builder needs this to link anywhere.
#   APP_URL=https://your-vercel-domain.com
APP_URL=https://frescati.xyz
