#!/usr/bin/env bash
#
# Run the repo's pinned fallow, whatever node happens to be first on the PATH.
#
#   scripts/bin/fallow audit --base origin/main
#   PATH="scripts/bin:$PATH" some-tool-that-shells-out-to-fallow
#
# Named `fallow` with no extension, and kept in a directory of its own, so that
# putting that directory on the PATH is all it takes for `command -v fallow` to
# find it. `.claude/hooks/fallow-gate.sh` looks fallow up that way and is
# regenerated by `fallow agent install`, so a PATH entry is the only fix that
# survives an upgrade; see docs/fallow.md.
#
# The problem is the same shape as the JDK in `emulators.sh`, one layer down.
# `node_modules/.bin/fallow` is a JS launcher that picks the native binary from
# `process.arch`, and fallow ships one platform package per architecture, so the
# only one pnpm installed is the one that matched the node that ran the install.
# This machine answers `node` with an x64 build while the tree is arm64, so the
# launcher looks for `@fallow-cli/darwin-x64`, finds nothing, and exits 1. The
# binary beside it is a native executable that runs perfectly well; nothing but
# the launcher ever cared what node reports. So skip the launcher.
#
# Failing here is deliberate rather than falling through to the launcher. A gate
# that cannot find its binary exits 0 with one line on stderr, and a PreToolUse
# hook never shows that line, so the quiet version of this is a commit gate that
# stopped gating and said so where nobody was looking.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# pnpm installs the one platform package that matched the install-time node, so
# this glob resolves to a single path. The npm and yarn layouts hoist the same
# package to the top level instead, hence the second pattern.
for candidate in \
	"$root"/node_modules/.pnpm/@fallow-cli+*/node_modules/@fallow-cli/*/fallow \
	"$root"/node_modules/@fallow-cli/*/fallow; do
	if [ -x "$candidate" ]; then
		exec "$candidate" "$@"
	fi
done

echo "fallow: no native binary under $root/node_modules/@fallow-cli." >&2
echo "fallow: run 'pnpm install' with the node in .nvmrc active." >&2
exit 1
