{
	"name": "frescati",
	"version": "1.0.0",
	"private": true,
	"description": "Football group manager for Frescati",
	"license": "ISC",
	"packageManager": "pnpm@10.34.1",
	"scripts": {
		"dev": "pnpm --filter frontend dev",
		"build": "pnpm --filter frontend build && pnpm --filter backend build",
		"lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:rules": "firebase emulators:exec --only firestore --project demo-frescati \"jest --config rules/jest.config.ts\"",
		"emulators": "firebase emulators:start",
		"seed": "pnpm --filter backend seed",
		"firebase": "firebase",
		"deploy:rules": "firebase deploy --only firestore:rules",
		"deploy:functions": "firebase deploy --only functions",
		"prepare": "husky",
		"preinstall": "npx only-allow pnpm"
	},
	"devDependencies": {
		"@firebase/rules-unit-testing": "5.0.0",
		"@types/jest": "29.5.14",
		"@types/node": "24.12.4",
		"firebase": "12.13.0",
		"firebase-tools": "15.18.0",
		"husky": "9.1.7",
		"jest": "29.7.0",
		"prettier": "3.8.3",
		"ts-jest": "29.4.11",
		"ts-node": "10.9.2",
		"typescript": "5.9.3"
	}
}
