rules_version = '2';

// Frescati — the client talks to Firestore directly, so these rules ARE the
// authorization layer. There is no API in front of them.
//
// Two roles:
//   * app admin  — the `admin` Firebase Auth custom claim. Creates seasons.
//   * season admin — listed in `adminUids` on a season. Runs that season.
//
// Anyone signed in can read seasons and games (that's how "extras" find a game
// to fill), but only their own response is theirs to write.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Read the claim with a default: most people don't carry `admin` at all, and
    // addressing a missing key directly *errors* rather than evaluating false.
    // Today that error is masked — `isSeasonAdmin` ORs this with a membership
    // check, and Firestore's `||` tolerates one side erroring when the other is
    // true — but anywhere this stands alone the error would deny the write.
    function isAppAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function seasonData(seasonId) {
      return get(/databases/$(database)/documents/seasons/$(seasonId)).data;
    }

    function isSeasonMember(seasonId) {
      return isSignedIn() && request.auth.uid in seasonData(seasonId).memberUids;
    }

    function isSeasonAdmin(seasonId) {
      return isAppAdmin() || (isSignedIn() && request.auth.uid in seasonData(seasonId).adminUids);
    }

    // Fields the client may never write — Cloud Functions own them.
    function touchesDerivedGameFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['counts', 'atRisk', 'remindersSent']);
    }

    // A brand new game has nobody in it, so every counter starts at zero — not
    // just `playing`. `values().hasOnly([0])` says "every value in this map is
    // 0", and the key check stops a short map slipping through with the missing
    // counters simply absent.
    function countsStartEmpty() {
      return request.resource.data.counts.keys()
               .hasOnly(['membersIn', 'membersOut', 'extrasIn', 'extrasOut', 'extrasConfirmed', 'playing'])
             && request.resource.data.counts.keys().size() == 6
             && request.resource.data.counts.values().hasOnly([0]);
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Readable by anyone signed in: the admin member-picker and every roster
    // needs names and avatars. Which is exactly why no contact details live
    // here — a profile is a name, an avatar and a badge, nothing more.
    match /users/{uid} {
      allow read: if isSignedIn();

      // Email is tolerated on an existing document but can never be added or
      // changed, only dropped. Profiles written before it moved out still carry
      // one, and refusing those outright would lock their owner out of signing
      // in until `strip-user-emails` had run — a deploy-order trap. Sign-in
      // clears the field, so they heal on their own.
      function keepsContactDetailsOut() {
        return !request.resource.data.keys().hasAny(['email'])
               || request.resource.data.email == resource.data.get('email', null);
      }

      // `isAppAdmin` is a display mirror of the custom claim. Let people create
      // their own doc but never grant themselves the badge.
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.isAppAdmin == false
                    && !request.resource.data.keys().hasAny(['email']);

      // Read through `get()` with a default rather than the field directly: a
      // doc written by `set-admin` alone may not carry every field, and a
      // missing key would make this expression error out and deny the write —
      // permanently locking its owner out of fixing their own profile.
      allow update: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.get('isAppAdmin', false)
                       == resource.data.get('isAppAdmin', false)
                    && keepsContactDetailsOut();

      allow delete: if false;

      // FCM registration tokens. Private to their owner — a token is a
      // capability to push to that device.
      match /pushTokens/{token} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── seasons ──────────────────────────────────────────────────────────────
    match /seasons/{seasonId} {
      allow read: if isSignedIn();

      // Only an app admin bootstraps a season, and must name themselves an admin
      // of it so it can't be created orphaned.
      allow create: if isAppAdmin()
                    && request.auth.uid in request.resource.data.adminUids;

      // A season admin can hand over the season but not abandon it: adminUids
      // must never end up empty.
      allow update: if isSeasonAdmin(seasonId)
                    && request.resource.data.adminUids.size() > 0;

      allow delete: if isAppAdmin();

      // ── games ──────────────────────────────────────────────────────────────
      match /games/{gameId} {
        allow read: if isSignedIn();

        // `kickoffMillis` is required rather than optional: it is what the
        // response deadline is enforced against, so a game without one would
        // silently never lock. Its agreement with `kickoff` can't be checked
        // here — rules can't parse ISO 8601 — but only season admins get this
        // far, and they can already set kickoff to whatever they like.
        //
        // Create has to be as strict as update about the function-owned fields.
        // Checking only `playing` left the other five counters free to be
        // seeded, and `remindersSent` could be pre-filled to silence every
        // reminder the game would ever send.
        allow create: if isSeasonAdmin(seasonId)
                      && request.resource.data.seasonId == seasonId
                      && request.resource.data.kickoffMillis is number
                      && countsStartEmpty()
                      && request.resource.data.atRisk == true
                      && !request.resource.data.keys().hasAny(['remindersSent']);

        allow update: if isSeasonAdmin(seasonId) && !touchesDerivedGameFields();

        allow delete: if isSeasonAdmin(seasonId);

        // ── responses ────────────────────────────────────────────────────────
        // The document id IS the uid, so one person can only ever hold one
        // response per game. No document at all means "no response" — that is a
        // real third state, so nothing here ever writes a placeholder.
        match /responses/{uid} {

          function gameData() {
            return get(/databases/$(database)/documents/seasons/$(seasonId)/games/$(gameId)).data;
          }

          // Still on, and the deadline hasn't passed. Takes the game as an
          // argument so the caller pays for exactly one `get()` of it.
          //
          // The deadline is read against `kickoffMillis` because a rule cannot
          // parse the ISO 8601 `kickoff`, and `responseDeadlineHours` is read
          // live off the season so changing it takes effect immediately rather
          // than only for games created afterwards.
          //
          // Games written before `kickoffMillis` existed default to a year far
          // enough out that they stay answerable — the same as the old
          // behaviour — until `backfill-kickoff-millis` has run over them.
          function responsesOpen(game) {
            return game.status == 'scheduled'
                   && request.time.toMillis()
                      < game.get('kickoffMillis', 9999999999999)
                        - seasonData(seasonId).responseDeadlineHours * 3600000;
          }

          // `role` is snapshotted onto the response, so it has to match reality
          // at write time — otherwise an extra could claim a member's ranking.
          function roleMatchesMembership() {
            return request.resource.data.role == (isSeasonMember(seasonId) ? 'member' : 'extra');
          }

          // Confirming or dropping an extra is an admin decision.
          function setsConfirmOverride() {
            return request.resource.data.keys().hasAny(['confirmOverride']);
          }

          allow read: if isSignedIn();

          allow create: if isSelf(uid)
                        && request.resource.data.uid == uid
                        && request.resource.data.status in ['in', 'out']
                        && roleMatchesMembership()
                        && !setsConfirmOverride()
                        && responsesOpen(gameData());

          // Changing your mind is allowed right up to the deadline. Past it the
          // headcount is what the organiser is acting on, so only a season admin
          // can still move it — see the admin `write` below.
          // `respondedAt` is the extras queue order, so it is written once and
          // then frozen. Without this an extra could backdate themselves ahead
          // of everyone who signed up before them.
          allow update: if isSelf(uid)
                        && request.resource.data.uid == uid
                        && request.resource.data.status in ['in', 'out']
                        && roleMatchesMembership()
                        && request.resource.data.get('respondedAt', null)
                           == resource.data.get('respondedAt', null)
                        && request.resource.data.get('confirmOverride', null)
                           == resource.data.get('confirmOverride', null)
                        && responsesOpen(gameData());

          allow delete: if isSelf(uid) && responsesOpen(gameData());

          // Season admins override extras and can clean up after anyone.
          allow write: if isSeasonAdmin(seasonId);
        }
      }
    }

    // Enables the collection-group query the app uses to load "my answers
    // across every game" in a single listener. Read-only: writes still have to
    // go through the nested rule above, which validates role and ownership.
    match /{path=**}/responses/{uid} {
      allow read: if isSignedIn();
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
