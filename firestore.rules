rules_version = '2';

// Frescati — the client talks to Firestore directly, so these rules ARE the
// authorization layer. There is no API in front of them.
//
// Two roles:
//   * app admin  — the `admin` Firebase Auth custom claim. Creates seasons.
//   * season admin — listed in `adminUids` on a season. Runs that season.
//
// Anyone signed in can read seasons and games (that's how "extras" find a game
// to fill), but only their own response is theirs to write.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Read the claim with a default: most people don't carry `admin` at all, and
    // addressing a missing key directly *errors* rather than evaluating false.
    // Today that error is masked — `isSeasonAdmin` ORs this with a membership
    // check, and Firestore's `||` tolerates one side erroring when the other is
    // true — but anywhere this stands alone the error would deny the write.
    function isAppAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function seasonData(seasonId) {
      return get(/databases/$(database)/documents/seasons/$(seasonId)).data;
    }

    function isSeasonMember(seasonId) {
      return isSignedIn() && request.auth.uid in seasonData(seasonId).memberUids;
    }

    function isSeasonAdmin(seasonId) {
      return isAppAdmin() || (isSignedIn() && request.auth.uid in seasonData(seasonId).adminUids);
    }

    // ── shared shapes ────────────────────────────────────────────────────────
    // Seasons and games are both readable by every signed-in user and writable
    // by season admins, and both hang maps off themselves. An allowlist stops
    // at the edge of a map, so each one it names needs bounding too — the same
    // reasoning as `clientShapeOk` on a profile, applied to the two documents
    // the whole app subscribes to.
    //
    // Sizes are generous on purpose. These bound a payload, they do not police
    // what an admin may sensibly type; a venue name that is too long is the
    // form's problem, not a permission error.
    function venueShapeOk(venue) {
      return venue.keys().hasOnly(['name', 'address', 'mapsUrl'])
             && venue.get('name', '') is string
             && venue.get('name', '').size() <= 120
             && venue.get('address', '') is string
             && venue.get('address', '').size() <= 200
             && venue.get('mapsUrl', '') is string
             && venue.get('mapsUrl', '').size() <= 500;
    }

    function slotShapeOk(slot) {
      return slot.keys().hasOnly(['weekday', 'time', 'durationMinutes', 'timezone'])
             && slot.get('weekday', 0) is int
             && slot.get('time', '') is string
             && slot.get('time', '').size() <= 5
             && slot.get('durationMinutes', 0) is number
             && slot.get('timezone', '') is string
             && slot.get('timezone', '').size() <= 60;
    }

    // A season carries all four; a game may override any subset of them.
    function balanceShapeOk(balance) {
      return balance.keys().hasOnly(['randomness', 'repeatPenalty', 'repeatLookback', 'matchMinutes'])
             && balance.get('randomness', 0) is number
             && balance.get('repeatPenalty', 0) is number
             && balance.get('repeatLookback', 0) is number
             && balance.get('matchMinutes', 0) is number;
    }

    // Fields the client may never write — Cloud Functions own them.
    //
    // `teamsGeneration` is in here because it is the staleness guard the
    // debounced team rebuild reads: a client that could move it could make
    // every queued rebuild believe it had been superseded, and the teams would
    // silently stop updating.
    // `motmVotingUntilMillis` is in here for the same reason `teamsGeneration`
    // is: it is not a setting, it is the deadline this file enforces the
    // man-of-the-match vote against. An admin who could move it could hold a
    // vote open forever, or reopen a decided one and have the ladder replayed
    // against a different winner.
    function touchesDerivedGameFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['counts', 'atRisk', 'remindersSent', 'teamsGeneration', 'resultFinalisedAt',
                 'motmVotingUntilMillis']);
    }

    // A brand new game has nobody in it, so every counter starts at zero — not
    // just `playing`. `values().hasOnly([0])` says "every value in this map is
    // 0", and the key check stops a short map slipping through with the missing
    // counters simply absent.
    function countsStartEmpty() {
      return request.resource.data.counts.keys()
               .hasOnly(['membersIn', 'membersOut', 'extrasIn', 'extrasOut', 'extrasConfirmed', 'playing'])
             && request.resource.data.counts.keys().size() == 6
             && request.resource.data.counts.values().hasOnly([0]);
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Readable by anyone signed in: the admin member-picker and every roster
    // needs names and avatars. Which is exactly why no contact details live
    // here — a profile is a name, an avatar and a badge, nothing more.
    match /users/{uid} {
      allow read: if isSignedIn();

      // Email is tolerated on an existing document but can never be added or
      // changed, only dropped. Profiles written before it moved out still carry
      // one, and refusing those outright would lock their owner out of signing
      // in until `strip-user-emails` had run — a deploy-order trap. Sign-in
      // clears the field, so they heal on their own.
      function keepsContactDetailsOut() {
        return !request.resource.data.keys().hasAny(['email'])
               || request.resource.data.email == resource.data.get('email', null);
      }

      // A profile is these fields and nothing else. Without an allowlist anyone
      // could hang arbitrary payloads off their own document — it is writable by
      // its owner and readable by everyone, which is a combination worth
      // bounding. `email` stays listed only so legacy documents still validate;
      // `keepsContactDetailsOut` is what stops it coming back.
      //
      // Read through `get()` throughout: profiles can legitimately be missing
      // fields mid-repair, and addressing an absent key errors rather than
      // yielding null.
      // `rating` is owned by the rating functions. It has to be frozen
      // explicitly rather than merely left off the allowlist, because this
      // document is writable by the person it describes — without this, anyone
      // could set their own rating to whatever they fancied and walk onto the
      // strongest team every week.
      //
      // Expressed as a diff rather than an equality so a profile that has no
      // rating yet — which is most of them — doesn't have to address a missing
      // key to prove it hasn't changed.
      function keepsRatingFrozen() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating']);
      }

      // The device notes behind the admin notification screen. Self-reported
      // and self-written, which is fine — nothing is authorized on the back of
      // it, and the worst a person can do is lie about their own phone. Bounded
      // anyway, because `client` being a map means the allowlist above stops at
      // its edge and anything could otherwise be nested inside a document the
      // whole group can read.
      function clientShapeOk() {
        return !request.resource.data.keys().hasAny(['client'])
               || (request.resource.data.client.keys().hasOnly(['platform', 'lastStandaloneAt'])
                   && request.resource.data.client.get('platform', '') is string
                   && request.resource.data.client.get('platform', '').size() <= 20
                   && request.resource.data.client.get('lastStandaloneAt', '') is string
                   && request.resource.data.client.get('lastStandaloneAt', '').size() <= 40);
      }

      // The four switches, and nothing else. Bounded for the same reason
      // `client` is — a map is where the allowlist below stops, and this
      // document is writable by its owner and read by every roster screen in
      // the app through one live listener over the whole collection. Anything
      // parked here is downloaded by everybody, repeatedly.
      //
      // Read with `get(key, true)` rather than addressed directly, because a
      // *partial* map has to stay valid: absent means opted in everywhere this
      // is consumed, so profiles written before a preference existed carry no
      // key for it and must not be locked out of every future write.
      //
      // `hasOnly` means a fifth preference has to be added here in the same
      // change that adds it to `NotificationPrefs`, or writes start failing.
      // Same coupling `clientShapeOk` already carries.
      function notificationPrefsShapeOk() {
        return !request.resource.data.keys().hasAny(['notificationPrefs'])
               || (request.resource.data.notificationPrefs.keys()
                     .hasOnly(['reminders', 'gameChanges', 'newPlayers', 'motm', 'emailFallback'])
                   && request.resource.data.notificationPrefs.get('reminders', true) is bool
                   && request.resource.data.notificationPrefs.get('gameChanges', true) is bool
                   && request.resource.data.notificationPrefs.get('newPlayers', true) is bool
                   && request.resource.data.notificationPrefs.get('motm', true) is bool
                   && request.resource.data.notificationPrefs.get('emailFallback', true) is bool);
      }

      function userShapeOk() {
        return request.resource.data.keys().hasOnly(
                 ['uid', 'displayName', 'photoURL', 'createdAt', 'lastSeenAt',
                  'isAppAdmin', 'notificationPrefs', 'email', 'rating', 'client'])
               && clientShapeOk()
               && notificationPrefsShapeOk()
               && request.resource.data.get('displayName', '') is string
               && request.resource.data.get('displayName', '').size() <= 100
               && request.resource.data.get('createdAt', '') is string
               && request.resource.data.get('createdAt', '').size() <= 40
               && request.resource.data.get('lastSeenAt', '') is string
               && request.resource.data.get('lastSeenAt', '').size() <= 40
               && (request.resource.data.get('photoURL', null) == null
                   || (request.resource.data.photoURL is string
                       && request.resource.data.photoURL.size() <= 1000));
      }

      // `isAppAdmin` is a display mirror of the custom claim. Let people create
      // their own doc but never grant themselves the badge.
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.isAppAdmin == false
                    && !request.resource.data.keys().hasAny(['email', 'rating'])
                    && userShapeOk();

      // Read through `get()` with a default rather than the field directly: a
      // doc written by `set-admin` alone may not carry every field, and a
      // missing key would make this expression error out and deny the write —
      // permanently locking its owner out of fixing their own profile.
      allow update: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.get('isAppAdmin', false)
                       == resource.data.get('isAppAdmin', false)
                    && keepsContactDetailsOut()
                    && keepsRatingFrozen()
                    && userShapeOk();

      allow delete: if false;

      // FCM registration tokens. Private to their owner — a token is a
      // capability to push to that device.
      match /pushTokens/{token} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── seasons ──────────────────────────────────────────────────────────────
    match /seasons/{seasonId} {

      // `responseDeadlineHours` being a number is the load-bearing one: the
      // response rule multiplies it, and a rule that errors *denies*. Written as
      // a string it locked every ordinary player out of every game in the
      // season, silently and invisibly from the admin's own account — season
      // admins keep writing through their own rule.
      //
      // `id` is on the allowlist for tolerance, not because anything should
      // write it. `createSeason` omits it and the seeder strips it, but on an
      // update `request.resource.data` is the *merged* document, so a stored key
      // this list didn't name would make that season permanently unwritable.
      // That is the failure mode worth being generous about.
      function seasonShapeOk() {
        return request.resource.data.keys().hasOnly(
                 ['id', 'name', 'status', 'startDate', 'endDate', 'venue', 'slot',
                  'minPlayers', 'responseDeadlineHours', 'reminderHours', 'balance',
                  'memberUids', 'adminUids', 'createdAt', 'createdBy'])
               && request.resource.data.get('name', '') is string
               && request.resource.data.get('name', '').size() <= 100
               && request.resource.data.get('status', '') is string
               && request.resource.data.get('status', '').size() <= 20
               && request.resource.data.get('startDate', '') is string
               && request.resource.data.get('startDate', '').size() <= 10
               && request.resource.data.get('endDate', '') is string
               && request.resource.data.get('endDate', '').size() <= 10
               && request.resource.data.get('responseDeadlineHours', 0) is number
               && request.resource.data.get('minPlayers', 0) is number
               && request.resource.data.get('reminderHours', []) is list
               && request.resource.data.get('reminderHours', []).size() <= 20
               && request.resource.data.get('memberUids', []) is list
               && request.resource.data.get('memberUids', []).size() <= 500
               && request.resource.data.get('createdAt', '') is string
               && request.resource.data.get('createdAt', '').size() <= 40
               && request.resource.data.get('createdBy', '') is string
               && request.resource.data.get('createdBy', '').size() <= 128
               && venueShapeOk(request.resource.data.get('venue', {}))
               && slotShapeOk(request.resource.data.get('slot', {}))
               && balanceShapeOk(request.resource.data.get('balance', {}));
      }

      // `size()` alone would not prove this is a list — it works on strings too,
      // and `adminUids: 'x'` passed while making `uid in adminUids` error, which
      // locked the season's own admins out of it.
      function keepsAnAdmin() {
        return request.resource.data.adminUids is list
               && request.resource.data.adminUids.size() > 0
               && request.resource.data.adminUids.size() <= 50;
      }

      allow read: if isSignedIn();

      // Only an app admin bootstraps a season, and must name themselves an admin
      // of it so it can't be created orphaned.
      allow create: if isAppAdmin()
                    && request.auth.uid in request.resource.data.adminUids
                    && keepsAnAdmin()
                    && seasonShapeOk();

      // A season admin can hand over the season but not abandon it: adminUids
      // must never end up empty.
      allow update: if isSeasonAdmin(seasonId)
                    && keepsAnAdmin()
                    && seasonShapeOk();

      allow delete: if isAppAdmin();

      // ── games ──────────────────────────────────────────────────────────────
      match /games/{gameId} {

        // Same reasoning as `seasonShapeOk`, on the document there is one of per
        // week and which every season screen subscribes to as a collection.
        //
        // The function-owned fields are named here so a merged update still
        // validates, not because a client may write them — `countsStartEmpty`
        // bounds `counts` at creation and `touchesDerivedGameFields` freezes it
        // and the rest afterwards, so there is nothing left for a shape check to
        // catch.
        function gameShapeOk() {
          return request.resource.data.keys().hasOnly(
                   ['id', 'seasonId', 'kickoff', 'kickoffMillis', 'endsAt', 'venue', 'status',
                    'minPlayers', 'balance', 'teamsGeneration', 'resultFinalisedAt',
                    'motmVotingUntilMillis', 'reshuffleCount', 'isOneOff', 'note',
                    'cancelledReason', 'counts', 'atRisk', 'remindersSent',
                    'createdAt', 'createdBy'])
                 && request.resource.data.get('seasonId', '') is string
                 && request.resource.data.get('seasonId', '').size() <= 128
                 && request.resource.data.get('kickoff', '') is string
                 && request.resource.data.get('kickoff', '').size() <= 40
                 && request.resource.data.get('endsAt', '') is string
                 && request.resource.data.get('endsAt', '').size() <= 40
                 // Required as a number on create below. Repeated here so an
                 // update cannot turn it into something the response deadline
                 // can no longer be compared against.
                 && request.resource.data.get('kickoffMillis', 0) is number
                 && request.resource.data.get('status', '') is string
                 && request.resource.data.get('status', '').size() <= 20
                 && request.resource.data.get('minPlayers', 0) is number
                 && request.resource.data.get('reshuffleCount', 0) is number
                 && request.resource.data.get('isOneOff', false) is bool
                 && request.resource.data.get('note', '') is string
                 && request.resource.data.get('note', '').size() <= 500
                 && request.resource.data.get('cancelledReason', '') is string
                 && request.resource.data.get('cancelledReason', '').size() <= 200
                 && request.resource.data.get('createdAt', '') is string
                 && request.resource.data.get('createdAt', '').size() <= 40
                 && request.resource.data.get('createdBy', '') is string
                 && request.resource.data.get('createdBy', '').size() <= 128
                 && venueShapeOk(request.resource.data.get('venue', {}))
                 && balanceShapeOk(request.resource.data.get('balance', {}));
        }

        allow read: if isSignedIn();

        // `kickoffMillis` is required rather than optional: it is what the
        // response deadline is enforced against, so a game without one would
        // silently never lock. Its agreement with `kickoff` can't be checked
        // here — rules can't parse ISO 8601 — but only season admins get this
        // far, and they can already set kickoff to whatever they like.
        //
        // Create has to be as strict as update about the function-owned fields.
        // Checking only `playing` left the other five counters free to be
        // seeded, and `remindersSent` could be pre-filled to silence every
        // reminder the game would ever send.
        allow create: if isSeasonAdmin(seasonId)
                      && request.resource.data.seasonId == seasonId
                      && request.resource.data.kickoffMillis is number
                      && countsStartEmpty()
                      && request.resource.data.atRisk == true
                      && !request.resource.data.keys().hasAny(['remindersSent', 'teamsGeneration',
                                                               'resultFinalisedAt',
                                                               'motmVotingUntilMillis'])
                      && gameShapeOk();

        allow update: if isSeasonAdmin(seasonId) && !touchesDerivedGameFields() && gameShapeOk();

        allow delete: if isSeasonAdmin(seasonId);

        // ── tournament ───────────────────────────────────────────────────────
        // The generated lineup, written only by `rebuildTeams`.
        //
        // Readable by anyone signed in — a team sheet nobody can see is no use
        // — and writable by nobody at all. That is the whole guarantee behind
        // the Reshuffle button being the only way to change a lineup: a player
        // cannot quietly move themselves onto the side they fancy, and two
        // admins looking at the same game cannot produce different teams.
        //
        // Reshuffling goes through `reshuffleCount` on the game document
        // instead, which is a season-admin write like any other.
        match /tournament/{docId} {
          allow read: if isSignedIn();
          allow write: if false;
        }

        // ── matches ──────────────────────────────────────────────────────────
        // The scoreboard. The document id is the fixture's position in the
        // running order, so two people scoring the same match write the same
        // document instead of creating two — and no document at all means "not
        // played yet", the same third state responses use.
        //
        // This is the only place in the app where somebody writes something
        // that isn't theirs, which is the point: whoever has a free hand and a
        // signal enters the score. The bound on who is `exists()` against their
        // own response, so it is the people actually at the pitch.
        match /matches/{order} {

          function respondedToThisGame() {
            return isSignedIn() && exists(
              /databases/$(database)/documents/seasons/$(seasonId)/games/$(gameId)/responses/$(request.auth.uid));
          }

          // Read live off the game rather than snapshotted, so confirming the
          // game closes the scoreboard immediately.
          function isFinalised() {
            return get(/databases/$(database)/documents/seasons/$(seasonId)/games/$(gameId))
                     .data.get('resultFinalisedAt', null) != null;
          }

          // Scores are the one thing here anyone can write, so they are bounded
          // like the response note is. Ninety-nine is far more than anybody
          // scores and far short of somewhere to park a number as a payload.
          function matchShapeOk() {
            return request.resource.data.keys().hasOnly(
                     ['order', 'teamA', 'teamB', 'scoreA', 'scoreB', 'updatedBy', 'updatedAt'])
                   && request.resource.data.order is int
                   && request.resource.data.order >= 0
                   // The document id IS the fixture's place in the running
                   // order — that is what makes two people scoring the same
                   // match write one document instead of two. Nothing tied the
                   // two together, so a score could be filed under an id
                   // nothing draws and still count in full towards the table
                   // and towards everyone's rating, invisibly: the screen only
                   // ever renders the fixtures the rotation produces.
                   //
                   // `int()` errors on an id that is not a number, and an error
                   // denies, so this also turns away `matches/whatever`.
                   && request.resource.data.order == int(order)
                   // A rotation now laps to fill the slot, so the real ceiling
                   // moves with the season and the match length — see
                   // `getFixtures` in shared/tournament.ts. `MAX_MATCHES` there
                   // is the one number that doesn't move, and is mirrored here
                   // the same way the four-team ceiling below is: a rule cannot
                   // read the season and the lineup to compute the real fixture
                   // count, so it bounds the worst case and `selectPlayedMatches`
                   // does the exact check on the way back out.
                   && request.resource.data.order < 30
                   && request.resource.data.teamA is int
                   && request.resource.data.teamB is int
                   && request.resource.data.teamA >= 0 && request.resource.data.teamA < 4
                   && request.resource.data.teamB >= 0 && request.resource.data.teamB < 4
                   && request.resource.data.teamA != request.resource.data.teamB
                   && request.resource.data.scoreA is int
                   && request.resource.data.scoreB is int
                   && request.resource.data.scoreA >= 0 && request.resource.data.scoreA <= 99
                   && request.resource.data.scoreB >= 0 && request.resource.data.scoreB <= 99
                   // Signed, so a correction has a face on it.
                   && request.resource.data.updatedBy == request.auth.uid
                   && request.resource.data.updatedAt is string
                   && request.resource.data.updatedAt.size() <= 40;
          }

          allow read: if isSignedIn();

          // A season admin keeps writing after the game is confirmed — that is
          // what makes a correction possible at all, and the rating replay is
          // built to follow one.
          allow create, update: if matchShapeOk()
                                && (isSeasonAdmin(seasonId)
                                    || (respondedToThisGame() && !isFinalised()));

          // Removing a score is on the same terms as writing one. "Not played"
          // is a real state and the absence of a document is the only thing
          // that says it, so a game where somebody scored a match that never
          // kicked off could not be put right by the people who were there.
          //
          // It hands nobody anything new: anyone who can overwrite a scoreline
          // can already destroy what it recorded, and a plausible wrong score
          // does more damage than a removal — it still counts towards the table
          // and towards everyone's rating, where a gap is visible on screen.
          allow delete: if isSeasonAdmin(seasonId)
                           || (respondedToThisGame() && !isFinalised());
        }

        // ── man of the match ─────────────────────────────────────────────────
        // One vote per player, the document id being the voter — so nobody
        // holds two, and changing your mind overwrites rather than stuffs the
        // ballot. No document means they haven't voted, the same third state
        // responses and scorelines use.
        //
        // Private to its owner, and this is the one place in the app where that
        // privacy is load-bearing rather than merely tidy: a running count
        // visible while the vote is open turns an early lead into a bandwagon.
        // The totals are published by the sweep that counts them, onto
        // `tournament/motm`, which everybody can read. Season admins and app
        // admins are shut out here like everyone else — an admin who could read
        // the votes as they arrived is exactly the leak this prevents.
        match /motmVotes/{uid} {

          // Everybody who was picked for this game, as up to four squads.
          //
          // The lineup rather than the responses: a vote is about who was on
          // the pitch, and the team sheet is the only record of that. It is
          // also function-written and unforgeable, where a response is
          // self-written — so this cannot be talked into counting somebody who
          // never played.
          //
          // A rule cannot flatten a list of maps, so the four-team ceiling is
          // mirrored here the way `matches` already mirrors it on `teamA`:
          // `MAX_TEAMS` in shared/tournament.ts is the number this tracks. The
          // guards are load-bearing rather than tidy — indexing past the end of
          // the list errors, and an error denies.
          function playedIn(squads, candidate) {
            return (squads.size() > 0 && candidate in squads[0].uids)
                   || (squads.size() > 1 && candidate in squads[1].uids)
                   || (squads.size() > 2 && candidate in squads[2].uids)
                   || (squads.size() > 3 && candidate in squads[3].uids);
          }

          // Both ends of the vote in one read of the team sheet: only somebody
          // who played may vote, and only for somebody who played.
          function isAValidVote() {
            let squads = get(/databases/$(database)/documents/seasons/$(seasonId)/games/$(gameId)/tournament/teams)
                           .data.teams;

            return playedIn(squads, request.auth.uid)
                   && playedIn(squads, request.resource.data.votedFor);
          }

          // Read live off the game, against the numeric deadline the function
          // put there — the same arrangement `kickoffMillis` exists for, and
          // for the same reason: a rule cannot parse an instant.
          //
          // Defaulting to 0 closes the vote for every game that has no window,
          // which is both a game nobody has confirmed yet and one whose votes
          // have already been counted. The sweep deletes the field as it writes
          // the decision, and that is what shuts the door behind it.
          function votingIsOpen() {
            return request.time.toMillis()
                   < get(/databases/$(database)/documents/seasons/$(seasonId)/games/$(gameId))
                       .data.get('motmVotingUntilMillis', 0);
          }

          function voteShapeOk() {
            return request.resource.data.keys().hasOnly(['uid', 'votedFor', 'votedAt'])
                   && request.resource.data.uid == uid
                   && request.resource.data.votedFor is string
                   && request.resource.data.votedFor.size() <= 128
                   && request.resource.data.get('votedAt', '') is string
                   && request.resource.data.get('votedAt', '').size() <= 40;
          }

          allow read: if isSelf(uid);

          allow create, update: if isSelf(uid)
                                && voteShapeOk()
                                && votingIsOpen()
                                && isAValidVote();

          // Taking a vote back is on the same terms as casting one. Abstaining
          // is a real position, and the absence of a document is the only thing
          // that says it.
          allow delete: if isSelf(uid) && votingIsOpen();
        }

        // ── watchers ─────────────────────────────────────────────────────────
        // Who has asked to hear when somebody's answer to this game moves. The
        // document id is the uid and its presence IS the subscription, so
        // unfollowing is a delete rather than a `false` — the same third state
        // responses and scorelines use.
        //
        // Private to its owner, like a push token. Not because it is sensitive
        // in the way a token is — it grants nothing — but because nothing needs
        // it: the only screen that reads this draws one person's own switch, and
        // a game the whole group can read has no business also publishing who is
        // quietly keeping an eye on it. `getWatcherUids` reads it with the Admin
        // SDK, which is not bound by any of this.
        //
        // Bounded like every other write a signed-in stranger can make against
        // any game. Nobody but the owner can read it, so this is about what can
        // be parked in the database rather than about who sees it.
        match /watchers/{uid} {

          function watcherShapeOk() {
            return request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                   && request.resource.data.uid == uid
                   && request.resource.data.get('createdAt', '') is string
                   && request.resource.data.get('createdAt', '').size() <= 40;
          }

          allow read, delete: if isSelf(uid);
          allow create, update: if isSelf(uid) && watcherShapeOk();
        }

        // ── responses ────────────────────────────────────────────────────────
        // The document id IS the uid, so one person can only ever hold one
        // response per game. No document at all means "no response" — that is a
        // real third state, so nothing here ever writes a placeholder.
        match /responses/{uid} {

          function gameData() {
            return get(/databases/$(database)/documents/seasons/$(seasonId)/games/$(gameId)).data;
          }

          // Still on, and the deadline hasn't passed. Takes the game as an
          // argument so the caller pays for exactly one `get()` of it.
          //
          // The deadline is read against `kickoffMillis` because a rule cannot
          // parse the ISO 8601 `kickoff`, and `responseDeadlineHours` is read
          // live off the season so changing it takes effect immediately rather
          // than only for games created afterwards.
          //
          // Games written before `kickoffMillis` existed default to a year far
          // enough out that they stay answerable — the same as the old
          // behaviour — until `backfill-kickoff-millis` has run over them.
          function responsesOpen(game) {
            return game.status == 'scheduled'
                   && request.time.toMillis()
                      < game.get('kickoffMillis', 9999999999999)
                        - seasonData(seasonId).responseDeadlineHours * 3600000;
          }

          // `role` is snapshotted onto the response, so it has to match reality
          // at write time — otherwise an extra could claim a member's ranking.
          function roleMatchesMembership() {
            return request.resource.data.role == (isSeasonMember(seasonId) ? 'member' : 'extra');
          }

          // Confirming or dropping an extra is an admin decision.
          function setsConfirmOverride() {
            return request.resource.data.keys().hasAny(['confirmOverride']);
          }

          // Anyone signed in can create one of these against any game, so this
          // is the widest-open write in the app and the one worth bounding.
          // `note` is the only free text; 280 characters is more than enough for
          // "back by 7, save me a spot" and far short of a place to park a
          // megabyte of someone else's data.
          function responseShapeOk() {
            return request.resource.data.keys().hasOnly(
                     ['uid', 'status', 'role', 'respondedAt', 'updatedAt', 'note', 'confirmOverride'])
                   && request.resource.data.get('note', '') is string
                   && request.resource.data.get('note', '').size() <= 280
                   && request.resource.data.get('respondedAt', '') is string
                   && request.resource.data.get('respondedAt', '').size() <= 40
                   && request.resource.data.get('updatedAt', '') is string
                   && request.resource.data.get('updatedAt', '').size() <= 40;
          }

          allow read: if isSignedIn();

          allow create: if isSelf(uid)
                        && request.resource.data.uid == uid
                        && request.resource.data.status in ['in', 'out']
                        && roleMatchesMembership()
                        && !setsConfirmOverride()
                        && responseShapeOk()
                        && responsesOpen(gameData());

          // Changing your mind is allowed right up to the deadline. Past it the
          // headcount is what the organiser is acting on, so only a season admin
          // can still move it — see the admin `write` below.
          // `respondedAt` is the extras queue order, so it is written once and
          // then frozen. Without this an extra could backdate themselves ahead
          // of everyone who signed up before them.
          allow update: if isSelf(uid)
                        && request.resource.data.uid == uid
                        && request.resource.data.status in ['in', 'out']
                        && roleMatchesMembership()
                        && request.resource.data.get('respondedAt', null)
                           == resource.data.get('respondedAt', null)
                        && request.resource.data.get('confirmOverride', null)
                           == resource.data.get('confirmOverride', null)
                        && responseShapeOk()
                        && responsesOpen(gameData());

          allow delete: if isSelf(uid) && responsesOpen(gameData());

          // Season admins override extras and can clean up after anyone.
          allow write: if isSeasonAdmin(seasonId);
        }
      }

      // ── kit ────────────────────────────────────────────────────────────────
      // What the group owns and who currently has it. One document per item.
      //
      // This is the second place in the app where somebody writes something
      // that isn't theirs, and it is the same bargain the scoreboard strikes:
      // a handover happens at the pitch between two people, and routing it
      // through an admin means it simply never gets recorded. So any member of
      // the season can move any item to any other member.
      //
      // What they cannot do is change what an item *is*. Naming, re-kinding,
      // adding and deleting stay with the season admins, because the kind is
      // what decides whether a game gets warned about a missing ball — a member
      // who could re-kind the vests as `other` could silence that warning for
      // the whole squad, which is a different power from carrying a bag home.
      match /kit/{itemId} {

        // `id` is deliberately not on this list: the document id is the id, the
        // way a response's is the uid. Nothing queries kit by anything but its
        // season, so a stored copy would only be a second thing to keep in step.
        function kitShapeOk() {
          return request.resource.data.keys().hasOnly(
                   ['name', 'kind', 'holderUid', 'updatedBy', 'updatedAt'])
                 && request.resource.data.name is string
                 && request.resource.data.name.size() > 0
                 && request.resource.data.name.size() <= 60
                 && request.resource.data.kind in ['ball', 'vests', 'other']
                 && request.resource.data.holderUid is string
                 && request.resource.data.holderUid.size() <= 128
                 // Signed, so a wrong handover has a face on it — the same
                 // reason `matches` pins `updatedBy` to the caller.
                 && request.resource.data.updatedBy == request.auth.uid
                 && request.resource.data.updatedAt is string
                 && request.resource.data.updatedAt.size() <= 40;
        }

        // An item is always handed to somebody on the roster. Checked on the way
        // in only: a member who leaves afterwards strands whatever they were
        // holding, which `findStrandedKit` surfaces rather than repairs — the
        // app has no idea who has it now, and guessing would replace a visible
        // problem with an invisible wrong answer.
        //
        // Which is why an update that leaves the holder alone skips it. Applied
        // to every write it stopped being a check on handovers and became a
        // freeze on the whole document: an admin couldn't fix a typo in the
        // name of the one item the register is actively complaining about until
        // they had first invented a new holder for it.
        function holderIsInTheSquad() {
          return request.resource.data.holderUid in seasonData(seasonId).memberUids;
        }

        function keepsItsHolder() {
          return request.resource.data.holderUid == resource.data.holderUid;
        }

        // A handover and nothing else. Without this a member could rename an
        // item or move it between kinds on the way past.
        function onlyHandsItOver() {
          return request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['holderUid', 'updatedBy', 'updatedAt']);
        }

        allow read: if isSignedIn();

        allow create: if isSeasonAdmin(seasonId) && kitShapeOk() && holderIsInTheSquad();

        allow update: if kitShapeOk()
                      && (keepsItsHolder() || holderIsInTheSquad())
                      && (isSeasonAdmin(seasonId) || (isSeasonMember(seasonId) && onlyHandsItOver()));

        allow delete: if isSeasonAdmin(seasonId);
      }

      // The subscribable calendar's token. Closed to every client, season
      // admin included — the only doors in are `getCalendarLink` and
      // `rotateCalendarToken`, which read and write it with the Admin SDK.
      // Nothing here is more sensitive than what `allow read: if isSignedIn()`
      // already hands out above; it just hands it to whoever holds the token,
      // signed in or not, which is exactly why a client write is never safe —
      // it would let anyone who can already read the season mint or overwrite
      // the one credential that skips signing in altogether.
      match /calendar/{docId} {
        allow read, write: if false;
      }
    }

    // Reverse index from a calendar token to the season it unlocks, so the
    // public feed function can look one up without a query. Same reasoning as
    // `seasons/{seasonId}/calendar` above: Admin SDK only, no client door.
    match /calendarFeeds/{token} {
      allow read, write: if false;
    }

    // ── rating ledger ────────────────────────────────────────────────────────
    // One entry per rated game, holding the exact rating every player carried
    // into it. Top-level rather than under the season because ratings are
    // global: a replay has to walk every rated game in kickoff order, and there
    // is nothing season-scoped to iterate.
    //
    // Written only by the finalise functions. This is the undo history for the
    // whole ladder — anyone able to edit it could rewrite everybody's rating by
    // forging what theirs used to be, and the replay would faithfully apply it.
    match /ratingLedger/{gameId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Enables the collection-group query the app uses to load "my answers
    // across every game" in a single listener. Read-only: writes still have to
    // go through the nested rule above, which validates role and ownership.
    match /{path=**}/responses/{uid} {
      allow read: if isSignedIn();
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
