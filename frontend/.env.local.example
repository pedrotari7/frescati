# Copy to .env.local. These are public by design, Firestore security rules are
# what actually protects the data, not the presence of these values.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAVqL8fohU4kuR3pGHvKM-__DyFv8WPfxc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=footballfrescati.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=footballfrescati
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=footballfrescati.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=881987940899
NEXT_PUBLIC_FIREBASE_APP_ID=1:881987940899:web:ab980beab87c4e3146b796
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XCPPT46LQ5

# Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# App Check. Firebase console -> Project settings -> App Check -> Apps -> your
# web app -> reCAPTCHA Enterprise. This is the *site* key, which is public like
# everything else above; the secret half never leaves Google.
#
# Leave blank and App Check is inert, the app runs, it just sends no attestation
# token, which is fine until enforcement is switched on for a service.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Only for `pnpm dev:live`, which points a localhost dev server at the real
# project, reCAPTCHA has no domain it recognises there, so without this every
# request goes out unattested. Generate one by running the app with App Check
# configured and reading the token the SDK logs to the console, then register it
# under App Check -> Apps -> Manage debug tokens.
#
# Never set this in production: it is a standing exemption from the check.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Sentry. sentry.io -> your project -> Settings -> Client Keys (DSN). Public
# like the Firebase config above: a DSN authorizes writing an event to one
# project and reads nothing back.
#
# Leave blank and the SDK is inert, the app runs, it just reports nothing.
# Reports are never sent from a `pnpm dev:seeded` run whatever this says.
NEXT_PUBLIC_SENTRY_DSN=

# Usually leave this empty: `pnpm dev:seeded` and `pnpm dev:live` set it for the
# dev server they start, and a stray 1 left in here points the app at emulators
# that may not be running. Set it to 1 only for a bare `pnpm dev` against
# emulators you started yourself.
NEXT_PUBLIC_USE_EMULATORS=
