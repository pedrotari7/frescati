#!/usr/bin/env sh

# The shell may export NPM_CONFIG_REGISTRY pointing at a private registry
# (e.g. a corporate artifactory), which overrides .npmrc. Force the public
# registry here so hook-triggered installs don't depend on the caller's env.
export NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# Only run the checks relevant to what's actually being committed:
# - frontend/-only changes -> frontend checks
# - backend/-only changes  -> backend checks
# - anything else (shared/root files, or both) -> run everything

changed_files=$(git diff --cached --name-only)

frontend_changed=false
backend_changed=false
other_changed=false

echo "$changed_files" | grep -q '^frontend/' && frontend_changed=true
echo "$changed_files" | grep -q '^backend/' && backend_changed=true
echo "$changed_files" | grep -vE '^(frontend/|backend/)' | grep -q . && other_changed=true

# One typecheck per tsconfig, and each runs before the build or the suite beside
# it, because it is the cheapest of the three and the only one that reads test
# files. Nothing else in this repo checks types: every suite runs through vitest
# or ts-node, both of which transpile, `next build` leaves the test files out of
# the check it does run, and eslint is not type-aware here.
run_root() {
  echo "Running shared checks..."
  pnpm install && pnpm lint:shared && pnpm format:shared && pnpm typecheck:root && pnpm test
}

run_frontend() {
  echo "Running frontend checks..."
  pnpm --filter frontend lint \
    && pnpm --filter frontend format:check \
    && pnpm --filter frontend typecheck \
    && pnpm --filter frontend build \
    && pnpm --filter frontend test
}

# `build` is a real `tsc`, so it checks `src/` and `shared/` on its way to
# emitting. `typecheck:scripts` is the wider one: it adds `scripts/`, which the
# build excludes because none of it is deployed, and which otherwise only ever
# meets a `--transpile-only` ts-node in front of every seed.
run_backend() {
  echo "Running backend checks..."
  pnpm --filter backend lint \
    && pnpm --filter backend format:check \
    && pnpm --filter backend typecheck:scripts \
    && pnpm --filter backend build
}

# Unconditional, unlike the three above, and cheap enough to be: fallow scopes
# itself to the files this commit touches and the whole repo takes about a
# second. It is also the only check here that reads the repo as a graph rather
# than a file at a time, so it is the only one that can see an export nothing
# imports any more, a dependency nothing needs, or an import cycle. None of
# those is a type error or a lint error, which is why every suite above can be
# green while they pile up.
#
# `scripts/bin/fallow` rather than `pnpm exec fallow`, because a git hook runs
# with whatever node the login shell resolves and the launcher in
# `node_modules/.bin` refuses to start when that node's architecture does not
# match the installed binary. The script skips the launcher; see the comment in
# it. Same gate as the Claude Code hook and the CI job, so all three agree.
run_fallow() {
  echo "Running fallow audit..."
  scripts/bin/fallow audit --quiet
}

# Unconditional, and not redundant with the three branches above even though
# they each format their own package now. Those cover `shared/`, `frontend/`
# and `backend/`; this is the only thing that has an opinion about the workflow
# files, the docs, the README, `e2e/`, `rules/` and `scripts/`, which belong to
# no package and are where 25 of the 31 files that were unformatted lived.
#
# `--cache` keeps it at about a second on a warm tree, so running it after the
# scoped checks have already passed over part of the tree costs almost nothing.
# The cache lives in node_modules and keys on the options as well as the file,
# so editing .prettierrc invalidates it rather than hiding behind it.
#
# `--check`, never `--write`: a hook that reformats files mid-commit stages
# nothing and leaves the working tree disagreeing with what was committed.
# `pnpm format` is the one that writes.
run_format() {
  echo "Checking formatting..."
  pnpm format:check
}

if [ "$other_changed" = true ] || { [ "$frontend_changed" = true ] && [ "$backend_changed" = true ]; }; then
  run_root || exit 1
  run_frontend || exit 1
  run_backend || exit 1
elif [ "$frontend_changed" = true ]; then
  run_frontend || exit 1
elif [ "$backend_changed" = true ]; then
  run_backend || exit 1
else
  echo "No tracked changes, skipping pre-commit checks."
fi

run_format || exit 1
run_fallow || exit 1
